token: {{ vault_k3s_token | to_json }}
node-name: {{ inventory_hostname | to_json }}
node-ip: {{ ansible_host | to_json }}
{% if inventory_hostname in groups.k3s_server %}
write-kubeconfig-mode: "0600"
cluster-cidr: {{ clinic_pod_cidr | to_json }}
service-cidr: {{ clinic_service_cidr | to_json }}
tls-san:
  - {{ ansible_host | to_json }}
secrets-encryption: true
{% else %}
server: "https://{{ hostvars[groups.k3s_server[0]].ansible_host }}:6443"
node-label:
  - "clinic.anuyen.io/storage-node=true"
{% endif %}
