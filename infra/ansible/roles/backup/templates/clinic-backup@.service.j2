[Unit]
Description=Clinic PostgreSQL backup %i
After=network-online.target docker.service k3s.service
[Service]
Type=oneshot
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
Environment=CLINIC_BACKUP_RETENTION_DAYS={{ clinic_backup_retention_days }}
ExecStart={{ clinic_backup_command | default('/usr/local/sbin/clinic-backup.sh') }} %i
UMask=0077
