# Quản lý bởi Ansible - không sửa tay
write-kubeconfig-mode: "0644"
node-ip: {{ node_ip }}
advertise-address: {{ node_ip }}
flannel-iface: {{ k3s_iface }}
tls-san:
  - {{ node_ip }}
{% for san in k3s_tls_san_extra %}
  - {{ san }}
{% endfor %}
token: {{ k3s_token }}
{% if k3s_etcd %}
cluster-init: true
{% endif %}
