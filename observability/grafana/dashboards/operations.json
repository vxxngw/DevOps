{
  "uid": "anuyen-operations",
  "title": "An Uyên Hospital · Vận hành",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "anuyen",
    "preparation-not-runtime-proof"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "query": "staging,production",
        "current": {
          "text": "staging",
          "value": "staging"
        },
        "multi": true,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU container (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "clinic-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clinic:container_cpu_cores5m{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} {{service}} {{container}} {{queue}} {{outcome}} {{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAM container",
