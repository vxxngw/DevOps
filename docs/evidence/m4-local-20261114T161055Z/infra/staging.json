  {
    "apiVersion": "v1",
    "data": {
      "nginx.conf": "pid /tmp/nginx.pid;\r\nerror_log /dev/stderr warn;\r\nevents { worker_connections 1024; }\r\nhttp {\r\n  include /etc/nginx/mime.types;\r\n  # Fixed categories keep IDs, query strings and tokens out of logs/metric labels.\r\n  map $uri $clinic_category {\r\n    default static;\r\n    /health health;\r\n    ~^/api/ api;\r\n  }\r\n  map $status $clinic_level { default INFO; ~^5 ERROR; }\r\n  map $upstream_http_x_request_id $clinic_request_id {\r\n    default $upstream_http_x_request_id;\r\n    \"\" $request_id;\r\n  }\r\n  log_format clinic_json escape=json '{\"timestamp\":\"$time_iso8601\",\"level\":\"$clinic_level\",'\r\n    '\"service\":\"frontend\",\"message\":\"http_request\",\"category\":\"$clinic_category\",'\r\n    '\"status\":\"$status\",\"duration\":$request_time,\"request_id\":\"$clinic_request_id\"}';\r\n  access_log /dev/stdout clinic_json;\r\n  client_body_temp_path /tmp/client_temp;\r\n  proxy_temp_path /tmp/proxy_temp;\r\n  fastcgi_temp_path /tmp/fastcgi_temp;\r\n  uwsgi_temp_path /tmp/uwsgi_temp;\r\n  scgi_temp_path /tmp/scgi_temp;\r\n  server {\r\n    listen 8080;\r\n    root /usr/share/nginx/html;\r\n    add_header X-Content-Type-Options nosniff always;\r\n    add_header Referrer-Policy same-origin always;\r\n    location = /health { default_type application/json; return 200 '{\"status\":\"ok\"}'; }\r\n    location /api/ {\r\n      proxy_pass http://api:8000;\r\n      proxy_connect_timeout 5s;\r\n      proxy_read_timeout 20s;\r\n      proxy_set_header Host $host;\r\n      proxy_set_header X-Request-ID $http_x_request_id;\r\n    }\r\n    location / { try_files $uri $uri/ /index.html; }\r\n  }\r\n}\r\n"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "nginx-config-8267f52g9c",
      "namespace": "staging"
    }
  },
