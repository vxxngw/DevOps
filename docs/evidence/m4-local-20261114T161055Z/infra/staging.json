  {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "postgres",
      "namespace": "staging"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "postgres"
        }
      },
      "serviceName": "postgres-headless",
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "postgres",
            "app.kubernetes.io/part-of": "anuyen"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "env": [
                {
                  "name": "PGDATA",
                  "value": "/var/lib/postgresql/data/pgdata"
                }
              ],
              "envFrom": [
                {
                  "secretRef": {
                    "name": "postgres-auth"
                  }
                }
              ],
              "image": "ghcr.io/vxxngw/devops-postgres:UNRELEASED",
              "livenessProbe": {
                "exec": {
                  "command": [
                    "pg_isready",
                    "-U",
                    "clinic",
                    "-d",
                    "clinic"
                  ]
                },
                "failureThreshold": 6,
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "name": "postgres",
              "ports": [
                {
                  "containerPort": 5432,
                  "name": "db"
                }
              ],
              "readinessProbe": {
                "exec": {
                  "command": [
                    "pg_isready",
                    "-U",
                    "clinic",
                    "-d",
