  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "api",
      "namespace": "staging"
    },
    "spec": {
      "replicas": 2,
      "revisionHistoryLimit": 5,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "api"
        }
      },
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "api",
            "app.kubernetes.io/part-of": "anuyen"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "command": [
                "python",
                "-m",
                "uvicorn",
                "clinic.api:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--no-access-log",
                "--log-config",
                "/app/services/logging.json",
                "--timeout-graceful-shutdown",
                "30"
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "app-config-8c55tf7kd9"
                  }
                },
                {
                  "secretRef": {
                    "name": "app-secrets"
                  }
                }
              ],
              "image": "ghcr.io/vxxngw/devops-app:UNRELEASED",
              "lifecycle": {
                "preStop": {
                  "exec": {
                    "command": [
                      "python",
                      "-c",
                      "import time; time.sleep(5)"
                    ]
                  }
                }
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/health",
                  "port": 8000
                },
                "periodSeconds": 10,
                "timeoutSeconds": 3
              },
              "name": "api",
              "ports": [
                {
                  "containerPort": 8000,
                  "name": "http"
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/ready",
                  "port": 8000
                },
                "periodSeconds": 5,
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "384Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              },
              "startupProbe": {
                "failureThreshold": 36,
                "httpGet": {
                  "path": "/health",
                  "port": 8000
                },
                "periodSeconds": 5
              },
              "volumeMounts": [
                {
                  "mountPath": "/tmp",
                  "name": "tmp"
                }
              ]
            }
          ],
          "imagePullSecrets": [
            {
              "name": "registry-pull"
            }
          ],
          "securityContext": {
            "fsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "serviceAccountName": "clinic-app",
          "terminationGracePeriodSeconds": 70,
          "volumes": [
            {
              "emptyDir": {},
              "name": "tmp"
            }
          ]
        }
      }
    }
  },
