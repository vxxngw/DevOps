alembic_version.alembic_version_pkc:PRIMARY KEY (version_num)
appointment_reminders.appointment_reminders_appointment_id_fkey:FOREIGN KEY (appointment_id) REFERENCES appointments(id)
appointment_reminders.appointment_reminders_event_id_fkey:FOREIGN KEY (event_id) REFERENCES outbox_events(id)
appointment_reminders.appointment_reminders_event_id_key:UNIQUE (event_id)
appointment_reminders.appointment_reminders_pkey:PRIMARY KEY (appointment_id)
appointment_reminders.appointment_reminders_status_check:CHECK (status::text = ANY (ARRAY['PENDING'::character varying::text, 'ENQUEUED'::character varying::text, 'CANCELLED'::character varying::text]))
appointment_slots.appointment_slots_check:CHECK (ends_at > starts_at)
appointment_slots.appointment_slots_doctor_id_fkey:FOREIGN KEY (doctor_id) REFERENCES doctors(id)
appointment_slots.appointment_slots_doctor_id_starts_at_key:UNIQUE (doctor_id, starts_at)
appointment_slots.appointment_slots_pkey:PRIMARY KEY (id)
appointments.appointments_pkey:PRIMARY KEY (id)
appointments.appointments_slot_id_fkey:FOREIGN KEY (slot_id) REFERENCES appointment_slots(id)
appointments.appointments_status_check:CHECK (status::text = ANY (ARRAY['BOOKED'::character varying::text, 'CANCELLED'::character varying::text, 'COMPLETED'::character varying::text]))
appointments.appointments_user_id_fkey:FOREIGN KEY (user_id) REFERENCES users(id)
doctors.doctors_pkey:PRIMARY KEY (id)
idempotency_keys.idempotency_keys_pkey:PRIMARY KEY (id)
idempotency_keys.idempotency_keys_user_id_fkey:FOREIGN KEY (user_id) REFERENCES users(id)
idempotency_keys.idempotency_keys_user_id_operation_key_key:UNIQUE (user_id, operation, key)
notification_deliveries.notification_deliveries_event_id_channel_recipient_key_key:UNIQUE (event_id, channel, recipient_key)
notification_deliveries.notification_deliveries_event_id_fkey:FOREIGN KEY (event_id) REFERENCES outbox_events(id)
notification_deliveries.notification_deliveries_pkey:PRIMARY KEY (event_id)
notification_deliveries.notification_deliveries_recipient_key_fkey:FOREIGN KEY (recipient_key) REFERENCES users(id)
notification_deliveries.notification_deliveries_status_check:CHECK (status::text = ANY (ARRAY['PENDING'::character varying::text, 'PROCESSING'::character varying::text, 'RETRY_PENDING'::character varying::text, 'SENT'::character varying::text, 'SKIPPED'::character varying::text, 'FAILED_DLQ'::character varying::text]))
outbox_events.outbox_events_appointment_id_fkey:FOREIGN KEY (appointment_id) REFERENCES appointments(id)
outbox_events.outbox_events_pkey:PRIMARY KEY (id)
users.users_email_key:UNIQUE (email)
users.users_pkey:PRIMARY KEY (id)
users.users_role_check:CHECK (role::text = ANY (ARRAY['patient'::character varying::text, 'admin'::character varying::text]))
alembic_version.alembic_version_pkc:CREATE UNIQUE INDEX alembic_version_pkc ON public.alembic_version USING btree (version_num)
appointment_reminders.appointment_reminders_event_id_key:CREATE UNIQUE INDEX appointment_reminders_event_id_key ON public.appointment_reminders USING btree (event_id)
appointment_reminders.appointment_reminders_pkey:CREATE UNIQUE INDEX appointment_reminders_pkey ON public.appointment_reminders USING btree (appointment_id)
appointment_reminders.ix_reminder_due:CREATE INDEX ix_reminder_due ON public.appointment_reminders USING btree (status, due_at)
appointment_slots.appointment_slots_doctor_id_starts_at_key:CREATE UNIQUE INDEX appointment_slots_doctor_id_starts_at_key ON public.appointment_slots USING btree (doctor_id, starts_at)
appointment_slots.appointment_slots_pkey:CREATE UNIQUE INDEX appointment_slots_pkey ON public.appointment_slots USING btree (id)
appointments.appointments_pkey:CREATE UNIQUE INDEX appointments_pkey ON public.appointments USING btree (id)
appointments.ix_appointments_user_id:CREATE INDEX ix_appointments_user_id ON public.appointments USING btree (user_id)
appointments.uq_occupied_slot:CREATE UNIQUE INDEX uq_occupied_slot ON public.appointments USING btree (slot_id) WHERE ((status)::text = ANY (ARRAY[('BOOKED'::character varying)::text, ('COMPLETED'::character varying)::text]))
doctors.doctors_pkey:CREATE UNIQUE INDEX doctors_pkey ON public.doctors USING btree (id)
idempotency_keys.idempotency_keys_pkey:CREATE UNIQUE INDEX idempotency_keys_pkey ON public.idempotency_keys USING btree (id)
idempotency_keys.idempotency_keys_user_id_operation_key_key:CREATE UNIQUE INDEX idempotency_keys_user_id_operation_key_key ON public.idempotency_keys USING btree (user_id, operation, key)
notification_deliveries.notification_deliveries_event_id_channel_recipient_key_key:CREATE UNIQUE INDEX notification_deliveries_event_id_channel_recipient_key_key ON public.notification_deliveries USING btree (event_id, channel, recipient_key)
notification_deliveries.notification_deliveries_pkey:CREATE UNIQUE INDEX notification_deliveries_pkey ON public.notification_deliveries USING btree (event_id)
outbox_events.ix_outbox_pending:CREATE INDEX ix_outbox_pending ON public.outbox_events USING btree (published_at, lease_until)
outbox_events.outbox_events_pkey:CREATE UNIQUE INDEX outbox_events_pkey ON public.outbox_events USING btree (id)
users.users_email_key:CREATE UNIQUE INDEX users_email_key ON public.users USING btree (email)
users.users_pkey:CREATE UNIQUE INDEX users_pkey ON public.users USING btree (id)
